# Thay base image Wolfi (cgr.dev bị chặn trong môi trường này) bằng python:3.12-slim.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/venv PATH="/venv/bin:${PATH}" VIRTUAL_ENV=/venv
WORKDIR /app
RUN pip install --no-cache-dir uv
COPY uv.lock pyproject.toml ./
RUN uv sync --frozen --no-dev --no-install-project
COPY LICENSE README.md alembic.ini ./
COPY src ./src
COPY alembic ./alembic
COPY images ./images
RUN uv sync --frozen --no-dev
EXPOSE 8000
ENTRYPOINT ["/venv/bin/python", "-m", "flight_blender.container_entrypoint"]
CMD ["serve"]
